# Supabase connection (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Dashboard auth (required)
DASHBOARD_ADMIN_PASSWORD=replace-with-a-strong-dashboard-password
DASHBOARD_SESSION_TOKEN=replace-with-a-long-random-session-token
DASHBOARD_PASSWORD_HINT=Hint keyword shown on the login page

# Telegram webhook integration (optional)
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
