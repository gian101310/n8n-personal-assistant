      "id": "reminder-read-tasks",
      "name": "Read Tasks",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 3,
      "position": [
        460,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const now = new Date();\nreturn $input.all()\n  .filter((item) => {\n    const j = item.json;\n    if (String(j.Type || \"\").toLowerCase() !== \"reminder\") return false;\n    if (String(j.Status || \"\").toLowerCase() !== \"open\") return false;\n    if (!j[\"Due At\"]) return false;\n    const due = new Date(j[\"Due At\"]);\n    return !Number.isNaN(due.getTime()) && due <= now;\n  })\n  .map((item) => ({\n    json: {\n      ...item.json,\n      reminderText: \"Reminder: \" + item.json.Task,\n      row_number: item.json.row_number\n    }\n  }));"
      },
      "id": "reminder-filter-due",
      "name": "Filter Due Reminders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "REPLACE_WITH_YOUR_TELEGRAM_CHAT_ID",
        "text": "={{ $json.reminderText }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "reminder-send",
      "name": "Send Reminder",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        940,
        300
      ],
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "sheet",
        "operation": "update",
        "documentId": {
          "mode": "id",
          "value": "162DpKJTcJROOaCVN7r5gUdOv3q1X17VvYvgMt-Du20Y"
        },
        "sheetName": {
          "mode": "name",
          "value": "Tasks"
        },
        "dataMode": "defineBelow",
