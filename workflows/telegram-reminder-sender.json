      ]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "resource": "sheet",
        "operation": "read",
        "documentId": {
          "mode": "id",
          "value": "162DpKJTcJROOaCVN7r5gUdOv3q1X17VvYvgMt-Du20Y"
        },
        "sheetName": {
          "mode": "name",
          "value": "Tasks"
        },
        "filtersUI": {},
        "combineFilters": "AND",
        "options": {}
